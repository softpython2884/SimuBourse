# Alvora Bourse — modèle de configuration.
# En production, deploy/deploy.sh génère ce fichier avec des secrets aléatoires.
# En local : cp .env.example .env puis ajustez.

NODE_ENV=development

# --- Réseau -----------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=4000
WEB_PORT=3000
PUBLIC_ORIGIN=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
# true derrière nginx, false si l'API est exposée directement.
TRUST_PROXY=true

# --- Base de données --------------------------------------------------------
DATABASE_URL=postgres://alvora:alvora_dev@127.0.0.1:5432/alvora
DATABASE_POOL_MAX=10

# --- Redis (facultatif) -----------------------------------------------------
# Active l'adaptateur Socket.IO partagé. Laissez vide pour tourner sans Redis.
REDIS_URL=

# --- Sécurité ---------------------------------------------------------------
# Au moins 32 caractères. Générez-en un avec: openssl rand -base64 48
JWT_SECRET=changez-moi-par-une-valeur-aleatoire-de-32-caracteres-minimum
# Laissez vide en local pour des cookies liés à l'hôte.
COOKIE_DOMAIN=
# true uniquement en HTTPS, sinon le navigateur refusera le cookie.
SECURE_COOKIES=false

# --- Moteur de simulation ---------------------------------------------------
# false met le marché en pause sans arrêter l'API (maintenance).
ENGINE_ENABLED=true
LOG_LEVEL=debug

# --- Premier administrateur (facultatif) ------------------------------------
# Créé au démarrage si aucun administrateur n'existe encore.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Front ------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_WS_URL=http://localhost:4000
NEXT_PUBLIC_SITE_NAME=Alvora
